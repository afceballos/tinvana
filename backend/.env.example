APP_ENV=local
APP_URL=http://127.0.0.1:8080
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
# Generate with php bin/console.php key:generate. Keep a backup outside the database.
TOKEN_ENCRYPTION_KEY=
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200
# Optional one-user import source: php bin/console.php webhook:import email
# Runtime deliveries use the encrypted per-user configuration from the panel.
GHL_WEBHOOK_URL=
GHL_TIMEOUT=15
# Optional outbound HTTPS CA bundle; does not disable TLS verification.
HTTP_CA_BUNDLE=
# Backend-only import, optional. Never committed; file must stay outside public/.
LEGACY_CONFIG_PATH=
TRUST_PROXY=false
# Enable ONLY behind a proxy that overwrites CF-IPCountry and blocks direct access.
# Used as an editable phone-country suggestion; falls back to Colombia.
TRUST_COUNTRY_HEADER=false
# Optional legacy OpenAI import ONLY: php bin/console.php ai:import email.
# Runtime always uses the active encrypted credential of the authenticated user.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=10


# Transactional account emails. Configure a verified sender with your SMTP provider.
MAIL_FROM_ADDRESS=no-reply@zenzales.com
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Run php backend/bin/console.php mail:work every minute.

# Alternative: Resend HTTPS API, no mailbox/SMTP needed. Verify the sender domain.
# MAIL_TRANSPORT=resend
MAIL_TRANSPORT=smtp
RESEND_API_KEY=
