APP_ENV=local
APP_URL=http://127.0.0.1:8080
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
# Generate with php bin/console.php key:generate. Keep a backup outside the database.
TOKEN_ENCRYPTION_KEY=
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200
# Optional one-user import source: php bin/console.php webhook:import email
# Runtime deliveries use the encrypted per-user configuration from the panel.
GHL_WEBHOOK_URL=
GHL_TIMEOUT=15
# Optional outbound HTTPS CA bundle; does not disable TLS verification.
HTTP_CA_BUNDLE=
# Backend-only import, optional. Never committed; file must stay outside public/.
LEGACY_CONFIG_PATH=
TRUST_PROXY=false
# Enable ONLY behind a proxy that overwrites CF-IPCountry and blocks direct access.
# Used as an editable phone-country suggestion; falls back to Colombia.
TRUST_COUNTRY_HEADER=false
# Optional legacy OpenAI import ONLY: php bin/console.php ai:import email.
# Runtime always uses the active encrypted credential of the authenticated user.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=10


# Transactional account emails. Configure a verified sender with your SMTP provider.
MAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Run php backend/bin/console.php mail:work every minute.

# Alternative: Resend HTTPS API, no mailbox/SMTP needed. Verify the sender domain.
# MAIL_TRANSPORT=resend
MAIL_TRANSPORT=smtp
RESEND_API_KEY=

# Ventas por WhatsApp (Meta WhatsApp Cloud API). Valores de la app de Meta de la plataforma, no de cada tienda.
# WHATSAPP_APP_SECRET: secreto de la app (Meta → Configuración de la app → Básica); valida X-Hub-Signature-256.
# WHATSAPP_VERIFY_TOKEN: texto que tú eliges y pegas también en Meta al configurar el webhook https://TU_DOMINIO/whatsapp/webhook.
# WHATSAPP_GRAPH_VERSION: versión de la Graph API (v26.0 era la vigente el 2026-10-26; revisa la documentación de Meta antes de cambiarla).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0

# Páginas legales públicas (/privacidad y /terminos). Datos del responsable; si faltan, no se muestran.
# LEGAL_EMAIL: correo para solicitudes de datos personales (si está vacío se usa MAIL_FROM_ADDRESS).
LEGAL_NAME=
LEGAL_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
