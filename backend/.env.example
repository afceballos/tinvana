APP_ENV=local
APP_URL=http://127.0.0.1:8080
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
# Generate with php bin/console.php key:generate. Keep a backup outside the database.
TOKEN_ENCRYPTION_KEY=
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200
# Optional one-user import source: php bin/console.php webhook:import email
# Runtime deliveries use the encrypted per-user configuration from the panel.
GHL_WEBHOOK_URL=
GHL_TIMEOUT=15
# Optional outbound HTTPS CA bundle; does not disable TLS verification.
HTTP_CA_BUNDLE=
# Backend-only import, optional. Never committed; file must stay outside public/.
LEGACY_CONFIG_PATH=
TRUST_PROXY=false
